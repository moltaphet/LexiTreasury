# =============================================================
# Environment & Secrets
# Never commit private keys, RPC credentials, or local config.
# Copy .env.example / frontend/.env.local.example and fill in.
# =============================================================
.env
.env.*
!.env.example
!.env.*.example
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# =============================================================
# Python
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.python-version

# Build / distribution
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

